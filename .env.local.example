# Copia este archivo a .env.local y rellena los valores.
# Los encuentras en tu proyecto de Supabase: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Buzón de sugerencias (envío de correo con Resend: resend.com)
RESEND_API_KEY=re_xxxxxxxx
CONTACTO_EMAIL_DESTINO=tu-correo@ejemplo.com
